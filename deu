  <title>Cancer incidence in Germany – interactive prototype (EXAMPLE DATA)</title>
  <style>
    :root { --ink:#1b2733; --muted:#5a6875; --bg:#f7f9fa; --line:#d5dde3; --accent:#0f5c6e; --warn:#ffd24d; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--ink); font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif; line-height:1.5; }
    a { color:var(--accent); }
    :focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
    .warn { background:var(--warn); color:#2b2100; text-align:center; padding:10px 16px; font-weight:700; letter-spacing:.02em; }
    .top { max-width:1100px; margin:0 auto; padding:14px 20px; border-bottom:1px solid var(--line); }
    .top a { text-decoration:none; color:var(--ink); }
    main { max-width:1100px; margin:0 auto; padding:24px 20px 60px; }
    h1 { font-family:Georgia,"Times New Roman",serif; font-size:1.8rem; margin:0 0 4px; line-height:1.2; }
    .sub { color:var(--muted); margin:0 0 20px; }
    .controls { display:flex; flex-wrap:wrap; gap:14px 22px; margin-bottom:22px; }
    .controls label { display:flex; flex-direction:column; font-size:.8rem; color:var(--muted); gap:3px; }
    select { font:inherit; font-size:.95rem; padding:6px 8px; border:1px solid var(--line); border-radius:4px; background:#fff; color:var(--ink); min-width:150px; }
    .grid { display:grid; grid-template-columns:minmax(260px,380px) 1fr; gap:28px; align-items:start; }
    @media (max-width:760px) { .grid { grid-template-columns:1fr; } }
    .mapbox { position:relative; background:#fff; border:1px solid var(--line); border-radius:6px; padding:12px; }
    .mapbox svg { width:100%; height:auto; display:block; }
    #de { transition:fill .35s ease; stroke:#fff; stroke-width:.8; }
    .wm { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none;
          font-size:2.6rem; font-weight:800; color:rgba(160,30,30,.16); transform:rotate(-28deg); text-align:center; line-height:1.1; }
    .readout { margin-top:10px; }
    .big { font-family:Georgia,serif; font-size:2.6rem; line-height:1; }
    .unit { color:var(--muted); font-size:.9rem; }
    .tag { display:inline-block; font-size:.75rem; font-weight:700; padding:2px 8px; border-radius:3px; margin-left:8px; vertical-align:middle; }
    .tag.obs { background:#dcebf0; color:#0b4452; } .tag.proj { background:#ece6f6; color:#4a2d82; }
    .legend { margin-top:12px; font-size:.8rem; color:var(--muted); }
    .bar { height:10px; border-radius:5px; margin:4px 0; }
    .legend div.r { display:flex; justify-content:space-between; }
    .yr { display:flex; align-items:center; gap:12px; margin-top:16px; }
    .yr input[type=range] { flex:1; accent-color:var(--accent); }
    .yr output { font-family:Georgia,serif; font-size:1.6rem; min-width:3.2ch; }
    button.play { font:inherit; padding:6px 14px; border:1px solid var(--accent); background:var(--accent); color:#fff; border-radius:4px; cursor:pointer; }
    .chart { background:#fff; border:1px solid var(--line); border-radius:6px; padding:14px; position:relative; }
    .chart h2 { font-size:1rem; margin:0 0 4px; }
    .chart svg { width:100%; height:auto; display:block; cursor:pointer; }
    .chart .wm { font-size:2rem; }
    .note { font-size:.85rem; color:var(--muted); margin-top:18px; }
    .sr { position:absolute; left:-9999px; }
  </style>
</head>
