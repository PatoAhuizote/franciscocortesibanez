  <script>
    var Y0 = 2015, Y1 = 2035, PROJ = 2025;
    var AGES = ["50–54","55–59","60–64","65–69","70–74"];
    var BASE = [300,480,720,1020,1330];
    var SEXL = {total:"both sexes", female:"women", male:"men"};
    var SITEL = {all:"All cancers", lung:"Lung", crc:"Colorectal"};
    var $ = function (id) { return document.getElementById(id); };

    // EXAMPLE generator (fictitious)
    function val(y, sex, age, site, ind) {
      var t = y - Y0;
      var sx = {total:1, female:.86, male:1.14}[sex], st = {all:1, lung:.13, crc:.12}[site];
      function f(i) { return BASE[i] * (1 + .004*t + .025*Math.sin(t/3 + i)); }
      var v;
      if (age === "all") { v = 0; for (var i = 0; i < 5; i++) v += f(i); v /= 5; }
      else v = f(+age);
      if (ind === "std") v *= (.93 - .004*t);
      return v * sx * st;
    }

    var ageSel = $("age");
    ageSel.innerHTML = '<option value="all">50–74 (all)</option>' + AGES.map(function (a, i) { return '<option value="' + i + '">' + a + '</option>'; }).join("");

    function lerp(a, b, t) { return Math.round(a + (b - a) * t); }
    function color(t) { return "rgb(" + lerp(222,15,t) + "," + lerp(234,61,t) + "," + lerp(242,87,t) + ")"; }
    $("bar").style.background = "linear-gradient(90deg," + color(0) + "," + color(1) + ")";

    function sel() { return {ind:$("ind").value, sex:$("sex").value, age:$("age").value, site:$("site").value}; }
    function series(s, sex) { var o = []; for (var y = Y0; y <= Y1; y++) o.push(val(y, sex, s.age, s.site, s.ind)); return o; }

    function sync() {
      var std = $("ind").value === "std";
      Array.prototype.forEach.call(ageSel.options, function (o) { o.disabled = std && o.value !== "all"; });
      if (std) ageSel.value = "all";
    }

    function draw() {
      sync();
      var s = sel(), y = +$("year").value;
      var ser = series(s, s.sex), all = ["total","female","male"].map(function (x) { return series(s, x); });
      var flat = [].concat.apply([], all), lo = Math.min.apply(null, ser), hi = Math.max.apply(null, ser);
      var v = ser[y - Y0], t = hi === lo ? 0 : (v - lo) / (hi - lo);
      $("de").style.fill = color(t);
      $("val").textContent = v.toFixed(1);
      var isP = y >= PROJ;
      $("tag").textContent = isP ? "Projection" : "Observed"; $("tag").className = "tag " + (isP ? "proj" : "obs");
      var aTxt = s.age === "all" ? "ages 50–74" : "ages " + AGES[+s.age];
      var kind = s.ind === "std" ? "age-standardised rate" : (s.age === "all" ? "crude rate" : "age-specific rate");
      $("unit").textContent = "per 100,000 (example), " + y;
      $("lo").textContent = lo.toFixed(0); $("hi").textContent = hi.toFixed(0);
      $("yout").textContent = y;
      $("desc").textContent = SITEL[s.site] + ", " + aTxt + ", " + SEXL[s.sex] + " – " + kind + " (EXAMPLE DATA).";
      $("ct").textContent = "Trend 2015–2035: " + kind + " per 100,000";

      // chart
      var W = 600, H = 340, L = 52, R = 14, T = 16, B = 38, ymax = Math.ceil(Math.max.apply(null, flat) * 1.08 / 50) * 50;
      function X(yr) { return L + (yr - Y0) / (Y1 - Y0) * (W - L - R); }
      function Yp(v) { return T + (1 - v / ymax) * (H - T - B); }
      var g = '<rect x="' + X(PROJ - .5) + '" y="' + T + '" width="' + (X(Y1) - X(PROJ - .5)) + '" height="' + (H - T - B) + '" fill="#ece6f6" opacity=".6"/>';
      g += '<text x="' + (X(PROJ - .5) + 6) + '" y="' + (T + 14) + '" font-size="11" fill="#4a2d82">Projection →</text>';
      for (var k = 0; k <= 4; k++) { var gv = ymax * k / 4, gy = Yp(gv);
        g += '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + gy + '" y2="' + gy + '" stroke="#e3e9ed"/><text x="' + (L - 8) + '" y="' + (gy + 4) + '" font-size="11" text-anchor="end" fill="#5a6875">' + Math.round(gv) + '</text>'; }
      [2015,2020,2025,2030,2035].forEach(function (yr) { g += '<text x="' + X(yr) + '" y="' + (H - 14) + '" font-size="11" text-anchor="middle" fill="#5a6875">' + yr + '</text>'; });
      var cols = {total:"#0f5c6e", female:"#c0506a", male:"#3a6fb0"};
      ["total","female","male"].forEach(function (sx, i) {
        var d = all[i], on = sx === s.sex;
        var pts = d.map(function (v2, j) { return [X(Y0 + j), Yp(v2)]; });
        function pl(a, b) { return pts.slice(a, b).map(function (p) { return p[0].toFixed(1) + "," + p[1].toFixed(1); }).join(" "); }
        var sw = on ? 3 : 1.5, op = on ? 1 : .55;
        g += '<polyline points="' + pl(0, PROJ - Y0 + 1) + '" fill="none" stroke="' + cols[sx] + '" stroke-width="' + sw + '" opacity="' + op + '"/>';
        g += '<polyline points="' + pl(PROJ - Y0, d.length) + '" fill="none" stroke="' + cols[sx] + '" stroke-width="' + sw + '" stroke-dasharray="6 4" opacity="' + op + '"/>';
      });
      g += '<line x1="' + X(y) + '" x2="' + X(y) + '" y1="' + T + '" y2="' + (H - B) + '" stroke="#1b2733" stroke-dasharray="2 3"/>';
      g += '<circle cx="' + X(y) + '" cy="' + Yp(v) + '" r="5" fill="' + cols[s.sex] + '" stroke="#fff" stroke-width="2"/>';
      g += '<g font-size="11"><text x="' + L + '" y="' + (H - 1) + '" fill="#0f5c6e">● Total</text><text x="' + (L + 60) + '" y="' + (H - 1) + '" fill="#c0506a">● Women</text><text x="' + (L + 132) + '" y="' + (H - 1) + '" fill="#3a6fb0">● Men</text></g>';
      $("ch").innerHTML = g;
      $("ch").dataset.l = L; $("ch").dataset.w = W - L - R;
    }

    ["ind","sex","age","site"].forEach(function (id) { $(id).addEventListener("change", draw); });
    $("year").addEventListener("input", draw);
    $("ch").addEventListener("click", function (e) {
      var r = this.getBoundingClientRect(), sc = 600 / r.width, x = (e.clientX - r.left) * sc;
      var yr = Math.round(Y0 + (x - 52) / (600 - 52 - 14) * (Y1 - Y0));
      $("year").value = Math.min(Y1, Math.max(Y0, yr)); draw();
    });
    var timer = null;
    $("play").addEventListener("click", function () {
      if (timer) { clearInterval(timer); timer = null; this.textContent = "Play"; return; }
      var b = this; b.textContent = "Pause";
      if (+$("year").value >= Y1) $("year").value = Y0;
      timer = setInterval(function () {
        var y = +$("year").value + 1;
        if (y > Y1) { clearInterval(timer); timer = null; b.textContent = "Play"; return; }
        $("year").value = y; draw();
      }, 650);
    });
    draw();
  </script>
</body>
</html>
